# ============================================================
#  لخّصلي — إعدادات السيرفر
#  انسخ هذا الملف باسم .env وعبّي القيم
# ============================================================

NODE_ENV=development
PORT=4100
# رابط الواجهة (Netlify) المسموح له بالوصول للسيرفر (CORS)
FRONTEND_URL=http://localhost:5500

# --- Firebase Admin SDK ---
# مشروع Firebase المستخدم: lakshle
FIREBASE_PROJECT_ID=lakshle
# باقي القيمتين من: Firebase Console > Project settings > Service accounts
# > Generate new private key (يحمّل ملف JSON خذ منه client_email و private_key)
FIREBASE_CLIENT_EMAIL=
# احتفظ بالأسطر الجديدة \n داخل القيمة كما هي عند اللصق
FIREBASE_PRIVATE_KEY=
# رابط قاعدة Realtime Database (لغرف السباق) — تأكد منه بعد إنشاء RTDB بالكونسول
# (لو اخترت موقعًا غير us-central1 الرابط يكون بصيغة region.firebasedatabase.app)
FIREBASE_DATABASE_URL=https://lakshle-default-rtdb.firebaseio.com

# --- تحويل الصوت إلى نص (Whisper API - OpenAI) ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- التلخيص والتحليل الذكي (Claude API - Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- حدود الرفع ---
# لا تُخزَّن الملفات نهائيًا: تُعالَج في الذاكرة/مؤقتًا على القرص ثم تُحذف فورًا.
# حد ملفات الصوت (ميغابايت) — واجهة Whisper API لا تقبل أكبر من 25MB
MAX_AUDIO_MB=25
# حد ملفات الفيديو (ميغابايت) — يُستخرج الصوت منه محليًا عبر ffmpeg قبل الحذف
MAX_VIDEO_MB=200
# حد ملفات PDF والصور (ميغابايت)
MAX_DOCUMENT_MB=20
