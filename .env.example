# ============================================================
#  احسمها AI — ملف الإعدادات
#  انسخ هذا الملف باسم .env وعبّي القيم
#  cp .env.example .env
# ============================================================

# --- أساسيات التشغيل ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# --- قاعدة البيانات (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://ahsmaha:CHANGE_ME@localhost:5432/ahsmaha?schema=public

# --- الدخول (حساب واحد فقط، بدون تسجيل جديد) ---
# الباسورد اللي بتدخل فيه. أول تشغيل يتخزن مشفّر في قاعدة البيانات.
# ولّد واحد قوي بـ: npm run gen:secrets -w server
OWNER_PASSWORD=

# --- مفاتيح الحماية (ولّدها بـ: npm run gen:secrets -w server) ---
# توقيع جلسة الدخول (32 بايت على الأقل)
SESSION_SECRET=
# تشفير المحادثات والملفات AES-256-GCM (32 بايت base64)
ENCRYPTION_KEY=

# --- محرك احسمها (استدلال محلي بالكامل — بدون أي شركة خارجية) ---
# الأوزان تُنزَّل مرة وحدة بأمر: npm run engine:pull -w server
ENGINE_MODELS_DIR=./.models
# اتركه فاضي عشان يأخذ أول ملف GGUF في المجلد تلقائيًا
ENGINE_MODEL_PATH=
ENGINE_CONTEXT_SIZE=8192
ENGINE_MAX_TOKENS=2048
ENGINE_TEMPERATURE=0.7
# 0 = يستخدم كل أنوية المعالج
ENGINE_THREADS=0

# --- الذاكرة الدائمة ---
# الاستخراج التلقائي يكلّف دورة توليد إضافية بعد كل رد.
# حطه false لو تبي أسرع رد، وتضيف الذكريات يدويًا من صفحة الذاكرة.
# --- البحث الحي ---
# اتركه فاضي عشان يستخدم DuckDuckGo بدون مفتاح.
# لو عندك SearxNG مستضاف، حط عنوانه هنا (أدق وأخصّ لك).
SEARXNG_URL=
AUTO_SEARCH=true

AUTO_MEMORY=true
AUTO_MEMORY_MIN_CHARS=15

# --- التخزين ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=100

# --- الذاكرة والاسترجاع (محلي بالكامل، بدون مزود خارجي) ---
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIM=384
