rules_version = '2';

// ============================================================================
//  قواعد أمان Firestore — لوحة "ادمن احسمها"
//
//  تحذير مهم جداً:
//  هذه اللوحة تعمل بنمط "العميل المباشر"، والحماية الفعلية للبيانات تأتي من هذا
//  الملف فقط. شاشة الدخول و2FA تحميان الواجهة، لكن أي شخص يملك إعداد الويب العام
//  يقدر يخاطب Firestore مباشرة — فما لم تُطبَّق هذه القواعد، تبقى الصلاحيات مكشوفة.
//
//  هذه القواعد تُشارك نفس مشروع ehsmaha (streamgame-180b8). لا تستبدل قواعدك
//  الحالية بالكامل — ادمج مقاطع "لوحة الأدمن" و"تجاوزات المالك" مع قواعدك القائمة
//  حتى لا يتعطّل الموقع الأساسي. راجِع كل مجموعة قبل النشر.
//
//  النشر:  firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // هوية المالك الوحيدة المصرّح لها (نفس حساب ehsmaha).
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'malshaifan1@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }

    // ----------------------------------------------------------------
    //  (1) مجموعات لوحة الأدمن — للمالك فقط، لا أحد غيره.
    // ----------------------------------------------------------------
    match /adminPanel/{doc}        { allow read, write: if isOwner(); }
    match /adminAuditLog/{doc}     { allow read, create: if isOwner(); allow update, delete: if false; }
    match /adminSecurityLog/{doc}  { allow read, create: if isOwner(); allow update, delete: if false; }
    match /adminSessions/{doc}     { allow read, write: if isOwner(); }

    // مجموعات تحكّم تكتبها اللوحة ويقرؤها الموقع الأساسي لفرض القرار:
    match /streamerDisabled/{id}   { allow read: if true;      allow write: if isOwner(); }
    match /gameMaintenance/{id}    { allow read: if true;      allow write: if isOwner(); }
    match /gameSettings/{id}       { allow read: if true;      allow write: if isOwner(); }
    // نقرات رابط احسمها: أي مستخدم مسجّل يُنشئ نقرة؛ القراءة/التعديل للمالك فقط.
    match /ahsemhaLinkClicks/{id}  { allow read: if isOwner(); allow create: if signedIn(); allow update, delete: if isOwner(); }

    // ----------------------------------------------------------------
    //  (2) تجاوزات المالك على مجموعات ehsmaha القائمة.
    //  اضبط هذه المقاطع لتشمل شرطك الحالي + "|| isOwner()".
    //  المثال أدناه: كل مستخدم يكتب مستنده، والمالك يكتب أي مستند (طرد/حظر/نقاط/حذف).
    // ----------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() || isOwner();
      allow write: if (signedIn() && request.auth.uid == uid) || isOwner();
    }
    match /usernames/{name}        { allow read: if true; allow write: if signedIn() || isOwner(); }
    match /presence/{uid} {
      allow read: if signedIn() || isOwner();
      allow write: if (signedIn() && request.auth.uid == uid) || isOwner();
    }
    // رسائل المالك للاعبين (اللوحة تكتب، اللاعب يقرأ مستنده) — عدّل حسب قواعدك.
    match /personalMessages/{name} { allow read: if true; allow write: if isOwner(); }
    match /broadcastMessages/{doc} { allow read: if true; allow write: if isOwner(); }
    // الدعم: المستخدم يُنشئ، المالك يقرأ/يرد/يؤرشف.
    match /feedback/{id} {
      allow create: if signedIn();
      allow read, update: if isOwner();
      allow delete: if isOwner();
    }
    // الغرف والأعضاء: المالك يقدر يطرد (يحذف عضوية).
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if signedIn() || isOwner();
      match /{sub=**} { allow read: if signedIn(); allow write: if signedIn() || isOwner(); }
    }
    match /leaderboards/{id}       { allow read: if true; allow write: if signedIn() || isOwner(); }
    match /playEvents/{id}         { allow read: if isOwner() || signedIn(); allow write: if signedIn(); }

    // ----------------------------------------------------------------
    //  (3) بقية مجموعات ehsmaha: أبقِ قواعدك الحالية كما هي هنا.
    //  (activeStreamers, liveCommands, shopProducts, storeSales, notifications,
    //   friendRequests, matchmakingQueue, moderators, moderatorSettings, ... إلخ)
    // ----------------------------------------------------------------
  }
}
